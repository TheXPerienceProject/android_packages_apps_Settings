    <string name="battery_saver_schedule_switch_summary">Ahorro de batería se activa cuando la batería cae a un nivel que hayas establecido</string>
    <string name="battery_saver_schedule_purpose">Permite a los usuarios configurar horarios para el modo de ahorro de batería, incluyendo la activación automática según el porcentaje de batería y la desactivación automática cuando se carga, así como administrar los recordatorios de notificación de batería baja.</string>
    <string name="battery_schedule_title">Programación y recordatorios</string>
    <string name="battery_schedule_summary">Administrar cuando el Ahorro de Batería se encienda</string>
    <string name="extreme_battery_saver_title">Ahorro de batería extremo</string>
    <string name="extreme_battery_saver_summary">Incluye todos los cambios mencionados anteriormente. También pausa las aplicaciones no esenciales y sus notificaciones.</string>
