<!--
    Copyright (C) 2026 The XPerience Project
    SPDX-License-Identifier: Apache-2.0

    ─────────────────────────────────────────────────────────────────
    my_device_info.xml  →  About Phone (Settings → About Phone)
    ─────────────────────────────────────────────────────────────────

    Structure:
      • ShrinkablePreference       ← hero OTA card (wallpaper blur + ROM name)
      • PreferenceCategory         ← card rows:
          ├ Android version        ← chevron → FirmwareVersionSettings
          ├ XPerience Version      ← reads ro.xperience.version
          ├ Maintainer             ← reads ro.xperience.build.status
          ├ Uptime                 ← live uptime counter
          ├ Build number           ← tap 7× to unlock developer options
          └ Device status          ← navigates → HardwareInfoFragment
                                     (model, SIM, IMEI, network, IDs…)

    NOTE: Device name, Account, SIM, IMEI, network IDs, legal, etc.
    have been moved into res/xml/hardware_info.xml (see that file).
    ─────────────────────────────────────────────────────────────────
-->
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:key="my_device_info_pref_screen"
    android:title="@string/about_settings">

    <!-- ── System Updates intent (hidden, used by OTA card) ── -->
    <Preference
        android:key="additional_system_update_settings"
        android:title="@string/additional_system_update_settings_list_item_title"
        android:order="-101"
        settings:controller="com.android.settings.system.AdditionalSystemUpdatePreferenceController">
        <intent android:action="android.intent.action.MAIN"
                android:targetPackage="@string/additional_system_update"
                android:targetClass="@string/additional_system_update_menu" />
    </Preference>

    <!-- ── Hero OTA card (blurred wallpaper + shrink animation) ── -->
    <com.xperience.widget.ShrinkablePreference
        android:key="ota_card"
        android:order="-100"
        settings:layout="@layout/xpe_tp_view" />

    <!-- ── Main info cards ── -->
    <PreferenceCategory
        android:key="device_detail_category"
        android:selectable="false"
        android:title=""
        android:layout="@layout/xpe_grouped_category_layout">

        <!-- Sección: About device -->
        <PreferenceCategory
            android:key="about_header"
            android:title="About device"/>

        <!-- Device name & Storage -->
        <com.xperience.widget.DualColumnPreference
            android:key="device_storage_dual"
            android:order="-99"
            settings:controller="com.android.settings.deviceinfo.xperience.DeviceStorageController" />

        <!-- Sección: Device specifications -->
        <!--<Preference
            android:key="specs_header"
            android:title="Device specifications"
            android:layout="@layout/xperience_section_header" />-->

        <!-- Processor -->
        <Preference
            android:key="processor_spec"
            android:title="Processor"
            android:summary="Snapdragon® 8 Elite Gen 5 Mobile Platform"
            android:selectable="false"
            app:layout="@layout/xpe_card_top_abt" />

        <!-- RAM -->
        <Preference
            android:key="ram_spec"
            android:title="RAM"
            android:summary="16.0 GB + 12.0 GB"
            android:selectable="false"
            app:layout="@layout/xpe_card_mid_abt"
            settings:controller="com.android.settings.deviceinfo.hardwareinfo.TotalRAMPreferenceController" />

        <!-- Battery -->
        <Preference
            android:key="battery_spec"
            android:title="Battery"
            android:summary="7300 mAh (TYP)\nsilicon-carbon battery"
            android:selectable="false"
            app:layout="@layout/xpe_card_mid_abt"
            settings:controller="com.android.settings.deviceinfo.xperience.XperienceBatteryController" />

        <!-- Cameras -->
        <Preference
            android:key="camera_spec"
            android:title="Cameras"
            android:summary="Front 32MP\nRear 50MP+50MP+50MP"
            android:selectable="false"
            app:layout="@layout/xpe_card_mid_abt"
            settings:controller="com.android.settings.deviceinfo.xperience.XperienceCameraController" />

        <!-- Build number -->
        <Preference
            android:icon="@drawable/build_acc"
            android:key="build_number"
            android:order="9"
            android:title="@string/build_number"
            android:summary="@string/summary_placeholder"
            app:enableCopying="true"
            app:controller="com.android.settings.deviceinfo.BuildNumberPreferenceController"
            app:layout="@layout/xpe_card_bot_abt"/>
        </PreferenceCategory>

        <!-- Separador visual -->
        <!--<Preference
            android:key="separator_2"
            android:selectable="false"
            android:layout="@layout/xperience_separator" />-->

        <!-- Sección: Software information -->
        <!--<Preference
            android:key="software_header"
            android:title="Software information"
            android:layout="@layout/xperience_section_header" />-->

        <PreferenceCategory
            android:key="device_firmware_category"
            android:selectable="false"
            android:title=""
            android:layout="@layout/xpe_grouped_category_layout">

        <!-- Android version -->
        <Preference
            android:key="firmware_version"
            android:title="Android version"
            android:summary="16"
            android:fragment="com.android.settings.deviceinfo.firmwareversion.FirmwareVersionSettings"
            app:layout="@layout/xpe_card_top_abt"
            settings:controller="com.android.settings.deviceinfo.firmwareversion.FirmwareVersionPreferenceController" />

        <!-- XPerience version -->
        <Preference
            android:key="xpe_version"
            android:order="15"
            android:title="@string/xpe_version"
            android:summary="@string/summary_placeholder"
            android:fragment="com.android.settings.deviceinfo.firmwareversion.FirmwareVersionSettings"
            app:controller="com.android.settings.deviceinfo.firmwareversion.XpeVersionPreferenceController"
            app:layout="@layout/xpe_card_mid_abt" />

        <!-- Device up time -->
        <Preference
            android:icon="@drawable/uptime"
            android:key="up_time"
            android:order="17"
            android:title="@string/status_up_time"
            android:summary="@string/summary_placeholder"
            android:selectable="false"
            app:layout="@layout/xpe_card_mid_abt"/>


        <!-- Device status (con chevron) -->
        <Preference
            android:key="device_model"
            android:title="Device status"
            android:summary="Model, phone number, IMEI, etc"
            android:fragment="com.android.settings.deviceinfo.hardwareinfo.HardwareInfoFragment"
            app:layout="@layout/xpe_card_bot_abt"
            app:enableCopying="true"
            app:keywords="@string/keywords_model_and_hardware"
            app:controller="com.android.settings.deviceinfo.HardwareInfoPreferenceController" />

        </PreferenceCategory>

</PreferenceScreen>
