    <!-- Battery Saver -->
    <string name="adaptive_battery_entry_purpose">Permite a los usuarios activar o desactivar la batería adaptativa, lo que optimiza el uso de la batería de la aplicación basándose en los patrones de uso del teléfono para prolongar la vida de la batería.</string>
