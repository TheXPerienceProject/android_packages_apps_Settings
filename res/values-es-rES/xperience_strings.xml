    <string name="adaptive_battery_switch_title">Usar batería adaptativa</string>
    <string name="basic_battery_saver_title">Ahorro de batería estándar</string>
    <string name="basic_battery_saver_summary">Limita los efectos visuales y la actividad en segundo plano. Activa el tema oscuro, si aún no está activado.</string>
    <string name="basic_battery_saver_purpose">Activa el modo de ahorro de batería estándar, que limita los efectos visuales y la actividad en segundo plano</string>
